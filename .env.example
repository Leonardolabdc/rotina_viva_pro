# --- Fase 1: Supabase (Postgres + Auth + RLS) — ver docs/FASE1_SUPABASE.md ---
# SUPABASE_URL=https://xxxxx.supabase.co
# (sem /rest/v1 no fim — só a URL base do projecto)
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # só scripts/backend — NUNCA no frontend
# SUPABASE_JWT_SECRET=sua-jwt-secret
# SUPABASE_DEMO_EMAIL_DOMAIN=rotinaviva.local
# ROTINA_API_PHASE=1-supabase
# ROTINA_API_PHASE=3-fastapi-worker
# ROTINA_API_PHASE=4-llm-guard

# --- Fase 4: LLM Guard (ML opcional no worker) ---
# ROTINA_LLM_GUARD_ENABLED=false
# ROTINA_LLM_GUARD_FAIL_OPEN=true
# ROTINA_LLM_GUARD_INPUT_THRESHOLD=0.5
# ROTINA_LLM_GUARD_OUTPUT_THRESHOLD=0.5

# --- Fase 5: CORS para Next.js (local + Vercel) ---
# ROTINA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://seu-app.vercel.app
# NEXT_PUBLIC_ROTINA_API_URL=http://127.0.0.1:8000   # só apps/web (.env.local)

# --- Fase 6: produção (worker Docker / Railway) ---
# PORT=8000
# ROTINA_DATA_DIR=/data
# Ver docs/DEPLOY_PROD.md e docs/FASE6_CUTOVER.md

# --- Fase 7: cadastro/diário no Supabase (ver docs/FASE7_SUPABASE_DADOS.md) ---
# ROTINA_DATA_BACKEND=csv
# ROTINA_DATA_BACKEND=supabase
# DATABASE_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres
# (pode incluir ?pgbouncer=true — o worker remove params que psycopg não aceita)

# --- RAG (Fase 2: pgvector no Supabase) ---
# ROTINA_RAG_BACKEND=chroma
# ROTINA_RAG_BACKEND=pgvector
# OPENAI_EMBED_DIMENSIONS=1536

# --- RAG / ChromaDB ---
# Índice vetorial persistente (pasta local). Só reindexa PDFs se estiver vazia ou se o manifest mudar.
# CHROMA_PERSIST_DIR=data/vector_db
# Trechos enviados ao LLM por pergunta (economia de tokens na resposta).
# ROTINA_RAG_TOP_K=3

# --- CONFIGURAÇÃO DE IA (OpenRouter) ---
ROTINA_CHAT_PROVIDER=openrouter
ROTINA_EMBED_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-or-v1-EXEMPLO_FICTICIO_SUBSTITUA_PELA_SUA_CHAVE
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct

OPENAI_EMBED_MODEL=openai/text-embedding-3-small

# Identificação para o OpenRouter (substitua pelo SEU fork/repositório GitHub)
OPENROUTER_HTTP_REFERER=https://github.com/SEU_USUARIO/Rotina-Viva
OPENROUTER_APP_TITLE=Rotina Viva

# --- TRANSCRIÇÃO DE VOZ ---
# Streamlit Cloud (recomendado): OpenRouter STT — mesma OPENROUTER_API_KEY
# OPENAI_TRANSCRIBE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_TRANSCRIBE_MODEL=openai/whisper-1
#
# Docker local / VM: Whisper multipart
# OPENAI_TRANSCRIBE_BASE_URL=http://whisper:9000/v1
# OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_BASE_URL=http://whisper:9000/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- PRODUÇÃO (imagem slim / deploy) ---
# Streamlit Cloud: use secrets (ver .streamlit/secrets.toml.example) — ROTINA_ENABLE_CREWAI=true
# Desligue funcionalidades pesadas no Docker prod se não forem necessárias:
# ROTINA_ENABLE_CREWAI=false
# ROTINA_ENABLE_ML_LAB=false
# ROTINA_LANGFUSE_ENABLED=false

# --- CONFIGURAÇÕES DE NEGÓCIO (Relatórios) ---
ROTINA_SONO_MAX_MIN=60
ROTINA_SONO_FAIXA_LIMITE_1=20
ROTINA_SONO_FAIXA_LIMITE_2=40

# --- Langfuse (observabilidade LLM — opcional; SDK Python 2.x no projecto por compatibilidade LiteLLM/CrewAI) ---
LANGFUSE_SECRET_KEY="sk-lf-EXEMPLO_FICTICIO_SUBSTITUA_PELA_SUA_CHAVE"
LANGFUSE_PUBLIC_KEY="pk-lf-EXEMPLO_FICTICIO_SUBSTITUA_PELA_SUA_CHAVE"
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com | self-host: URL base do projecto
# Pode usar só `LANGFUSE_HOST` em vez de `LANGFUSE_BASE_URL` (o arranque sincroniza os dois para LiteLLM/SDK).
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# LANGFUSE_HOST=https://cloud.langfuse.com
# Observabilidade desligada por defeito (opt-in): ROTINA_LANGFUSE_ENABLED=true
# ROTINA_LANGFUSE_ENABLED=false
# Truncagem de entrada enviada ao Langfuse (por mensagem): ROTINA_LANGFUSE_MAX_CHARS_PER_MSG=12000
# LiteLLM/CrewAI: no `docker-compose.yml` já vão `LITELLM_SUCCESS_CALLBACKS` e `LITELLM_FAILURE_CALLBACKS=langfuse`
# (o CrewAI só copia success_callback a partir do env quando failure também está definido — bug/limitação upstream).

# --- Segurança (LLM / LGPD) — ver docs/RELATORIO_SEGURANCA_LLM.md ---
# ROTINA_CHAT_HISTORY_MAX_MESSAGES=8
# ROTINA_CHAT_HISTORY_MAX_CHARS=1200
# ROTINA_LLM_DAILY_MESSAGES_PER_USER=200
# ROTINA_ALLOW_GOOGLE_STT=false
# ROTINA_EMOTION_TRANSLATE_FALLBACK=0
# ROTINA_SESSION_IN_URL=false
# UPDATE sem WHERE id_aluno/id_registro exige confirmação na UI (como DELETE)